# --- Plaintext secrets: never commit ---------------------------------------
secrets.env
secrets.yaml
secrets.*.env
secrets.*.yaml
*.dec
*.dec.*

# ...but the SOPS *ciphertext* is the whole point of this repo and must be
# tracked. These negations have to come after the rules above: `secrets.*.env`
# matches `secrets.enc.env` too, which would silently make every encrypted
# secret un-committable.
!secrets.enc.env
!secrets.enc.yaml
!secrets.enc.json
!secrets.env.example

# --- Intentionally tracked -------------------------------------------------
# Pinned image tags live in stacks/<vm>/<stack>/.env and MUST be committed, so
# make sure no broad .env rule ever shadows them. The depth matters: this repo
# holds one directory per VM, so the pattern needs two wildcards.
#   git check-ignore -v stacks/isws/traefik/.env   # must report nothing
!stacks/*/*/.env
# ...and the shared template, which sits one level shallower.
!stacks/_template/.env

# --- Keys: never, under any circumstances ----------------------------------
*.agekey
*.age.key
age.key
keys.txt

# htpasswd files - convienient to generate them locally
htpasswd

# --- Runtime / local junk --------------------------------------------------
acme.json
*.bak
*.new
*.orig
.DS_Store
