# Brings every enabled stack up at boot, and tears them down on shutdown.
#
# Install with:  sudo /opt/isws-vm/bin/stacks install
# Logs with:     journalctl -u isws-stacks -f

[Unit]
Description=ISWS VM docker-compose stacks
Documentation=https://github.com/BenGalewsky/isws-vm
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# The age key lives on the /data volume; do not start before it is mounted.
RequiresMountsFor=/data/secrets

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/isws-vm

# The age private key that decrypts stacks/*/secrets.enc.env. On the persistent
# /data volume so it survives a VM rebuild. Must be 0600 root:root.
# See docs/secrets.md.
Environment=SOPS_AGE_KEY_FILE=/data/secrets/age.key
Environment=NO_COLOR=1

ExecStart=/opt/isws-vm/bin/stacks up
ExecStop=/opt/isws-vm/bin/stacks down

# A cold first boot pulls every image before anything reports ready.
TimeoutStartSec=900
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
