# Weekly report of available image updates. Deliberately a DRY RUN: on a machine
# serving real users, deciding to take a new release is a human's call. The
# output lands in the journal.
#
#   journalctl -u isws-stacks-bump --since '1 week ago'
#
# Install with:
#   sudo cp systemd/isws-stacks-bump.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now isws-stacks-bump.timer

[Unit]
Description=Report available container image updates for the ISWS stacks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/isws-vm
Environment=NO_COLOR=1
ExecStart=/opt/isws-vm/bin/stacks bump
