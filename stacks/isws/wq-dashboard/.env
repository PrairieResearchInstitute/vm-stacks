# Non-secret configuration for the wq-dashboard stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.

WQ_DASHBOARD_TAG=v1.0.1

# Hostname Traefik serves this application on. DNS for it has to resolve to the
# isws VM before Let's Encrypt can issue a certificate -- until it does, point
# traefik's TRAEFIK_ACME_CASERVER at staging rather than burning prod rate limit.
WQ_DASHBOARD_HOST=wq-dashboard.isws.prairie.illinois.edu

# Where in the object store the application looks for its data. Not secrets --
# only the credentials that reach them are, and those are in secrets.enc.env
# alongside S3_ENDPOINT.
#
# The image reads both by these exact names, so they are spelled unprefixed
# here rather than as WQ_DASHBOARD_*.
S3_BUCKET=private
S3_PREFIX=tlpa/wq
