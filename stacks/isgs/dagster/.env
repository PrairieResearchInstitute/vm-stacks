# Non-secret configuration for the dagster stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.

# MUST HOLD THE SAME VALUE AS WATERDB_TAG in ../waterdb/.env. The Dagster image
# reads application tables whose schema the web application owns, and the two are
# published together on one GitHub release. Nothing enforces it -- see the note in
# stack.conf -- so move both in one commit.
#
# There is no `latest` tag on these packages; the tag is always explicit.
DAGSTER_TAG=0.1-alpha.3

# Hostname Traefik serves the Dagster UI on. DNS for it has to resolve to the
# isgs VM before Let's Encrypt can issue a certificate -- until it does, point
# traefik's TRAEFIK_ACME_CASERVER at staging rather than burning prod rate limit.
#
# There is no host port for this UI, deliberately: Dagster OSS ships no
# authentication of its own, so the only way in is through the proxy and the
# basic-auth middleware in docker-compose.yml. See README.md.
DAGSTER_HOST=dagster.isgs.prairie.illinois.edu

# --- provisioning job (see docker-compose.yml, provision-db.sh) --------------

# Client image for the provisioning job: the same image the postgres stack runs
# as a server. A matching tag means the host holds one copy of it rather than
# several, so keep this stack, ../waterdb and ../postgres in step when bumping.
POSTGRES_TAG=18.6

# Must match POSTGRES_SOCKET_DIR in the postgres stack's .env -- nothing checks
# this, and a mismatch means a job that cannot find the socket. The job mounts
# it read-only and connects over it, which is why no admin password appears
# anywhere in this stack.
POSTGRES_SOCKET_DIR=/run/postgresql

# Must match POSTGRES_ADMIN_USER in the postgres stack's .env. Needed even
# though socket connections need no password: `trust` still authenticates as
# some role, and there is no `postgres` role in this cluster -- initdb named the
# superuser after that variable.
POSTGRES_ADMIN_USER=pgadmin

# The role and database the provisioning job reconciles on every `up`. This is
# Dagster's own INSTANCE STORAGE -- run, event log, schedule and dynamic
# partition tables -- not application data. Not secrets; the password is
# DAGSTER_DB_PASSWORD in secrets.enc.env.
#
# It has to be a real database on a real server rather than the SQLite default:
# the webserver, the daemon and every run container are separate processes and
# must share these tables.
DAGSTER_DB_NAME=dagster
DAGSTER_DB_USER=dagster

# --- the application database Dagster reads and writes -----------------------

# Restates ../waterdb/.env. Dagster's assets read and write the web
# application's tables, so DATABASE_URL below is built from the application's
# own role -- the `dagster` role above owns instance storage only. The password
# is WATERDB_DB_PASSWORD, copied into this stack's secrets.enc.env.
#
# Nothing checks that these match the waterdb stack; one stack's .env cannot
# read another's. A mismatch shows up as an authentication failure in
# dagster-code's logs when a sensor first ticks.
WATERDB_DB_NAME=waterdb
WATERDB_DB_USER=waterdb

# --- object stores -----------------------------------------------------------

# There is NO S3_BUCKET variable, deliberately: nothing in the image reads one.
# processed_graph_files.py hardcodes bucket `graphing-data`, and data_logger.py
# and sonde_data.py parse the bucket out of the s3:// URIs they read from the
# application database.
#
# There are TWO object stores, and both are off-host -- there is no object store
# container on this VM, so the run containers need outbound HTTPS on
# non-standard ports:
#
#   S3_*     ObjectStoreResource -- the endpoint the web application also uses,
#            for the URIs it wrote into the application database.
#   TAIGA_*  TaigaResource -- bucket `graphing-data`, read by discover_s3_folders
#            and processed_graph_files. This is the main ingestion path.
#
# All six values are in secrets.enc.env. The S3_* three are copies of
# ../waterdb/secrets.enc.env; the TAIGA_* three are unique to this stack.

# --- shared storage (see dagster.yaml) ---------------------------------------

# Host directories shared between the webserver, the daemon and every run
# container. Bind mounts on /data rather than Docker named volumes, for the same
# reason as the postgres cluster and the staged waterdb data: they have to
# survive a rebuild of the machine's root filesystem.
#
# There is a second reason here. The run launcher talks to the Docker API
# directly and knows nothing about Compose's `<project>_` volume prefixing, so a
# named volume would have to be pinned with an explicit `name:` or the run
# containers would silently mount a different, auto-created volume of their own
# and the UI would show no logs at all. A host path has no name for Compose to
# prefix, so both sides resolve to the same directory by construction.
#
# Created by the daemon if absent; Dagster runs as root, so nothing needs
# preparing by hand. Unlike WATERDB_DATA_DIR these are not operator-staged
# input -- they start empty.
#
# DAGSTER_STORAGE_DIR holds op stdout/stderr, which is what the UI reads back
# for a finished run. DAGSTER_SCRATCH_DIR is ISGS_SCRATCH_DIR inside the image
# (/scratch), where one asset writes CSV output.
DAGSTER_STORAGE_DIR=/data/dagster/storage
DAGSTER_SCRATCH_DIR=/data/dagster/scratch
