# Non-secret configuration for the postgres stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.

POSTGRES_TAG=18.6

# Superuser created by initdb on first boot. Its password is POSTGRES_ADMIN_PASSWORD
# in secrets.enc.env.
#
# Changing this after the first boot does NOT rename the role -- initdb only runs
# against an empty data directory. Rename it in SQL instead.
POSTGRES_ADMIN_USER=pgadmin

# Host directory holding the cluster, bind-mounted at /var/lib/postgresql.
#
# On /data, a persistent volume, rather than a Docker named volume: the cluster
# has to survive a rebuild of the machine's root filesystem, same reasoning as
# the age key in /data/secrets. The image's PGDATA is
# /var/lib/postgresql/18/docker, so the files actually land in
# ${POSTGRES_DATA_DIR}/18/docker.
POSTGRES_DATA_DIR=/data/postgres

# Passed to initdb on first boot only. --data-checksums makes Postgres detect
# silent corruption on read; it cannot be turned on later without rewriting the
# cluster, so it goes on from the start.
POSTGRES_INITDB_ARGS=--data-checksums
