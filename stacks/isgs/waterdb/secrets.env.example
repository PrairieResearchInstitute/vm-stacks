# Template for the waterdb stack's secrets. This .example file is plaintext and
# committed; the real values live in secrets.enc.env, encrypted to the isgs rule
# in .sops.yaml. Delete this file once that one exists.
#
# To create the encrypted file:
#   stacks --vm isgs edit-secrets waterdb
#
# ...or from an existing plaintext file. Give --filename-override the full
# repo-relative PATH, not just the basename: .sops.yaml matches creation rules on
# the path, so the bare name hits the catch-all and produces a file the isgs VM
# cannot read.
#   sops --encrypt --filename-override stacks/isgs/waterdb/secrets.enc.env \
#        --input-type dotenv --output-type dotenv secrets.env \
#        > stacks/isgs/waterdb/secrets.enc.env
#   rm secrets.env

# Base URL of the S3 API, e.g. https://s3.us-east-1.amazonaws.com or the
# endpoint of a MinIO/Ceph deployment. Kept here with the credentials it belongs
# to rather than in .env.
S3_ENDPOINT=replace-me

# Credential pair for the bucket named by WATERDB_S3_BUCKET in .env. Scope it to
# that bucket -- read-only if the application never writes.
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Password for the `waterdb` role in the shared postgres cluster. The
# provisioning job in docker-compose.yml sets the role's password to this value
# on every `stacks up waterdb`, so rotating it here and running `up` is the whole
# rotation procedure -- there is no SQL to run by hand.
#
# Make it long and random; nothing types it interactively. Keep it to
# URL-SAFE characters -- hex below rather than base64:
#   openssl rand -hex 32
#
# The provisioning job sets it with a quoted psql literal, so any byte works on
# the role itself. But this same value is interpolated into the DATABASE_URL
# that docker-compose.yml hands the application and the seeding job, and there
# `/ @ : ? # %` either terminate the URI's authority or get percent-decoded
# into something else. `openssl rand -base64 33` emits `/` and `+`, so it is the
# wrong generator here.
WATERDB_DB_PASSWORD=replace-me
