# Non-secret configuration for the waterdb stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.

WATERDB_TAG=0.1-alpha.3

# Hostname Traefik serves this application on. DNS for it has to resolve to the
# isgs VM before Let's Encrypt can issue a certificate -- until it does, point
# traefik's TRAEFIK_ACME_CASERVER at staging rather than burning prod rate limit.
WATERDB_HOST=waterdb.isgs.prairie.illinois.edu

# S3 bucket holding the water data. Not a secret; the credentials for it are in
# secrets.enc.env.
WATERDB_S3_BUCKET=isgs-waterdb

# --- provisioning job (see docker-compose.yml, provision-db.sh) --------------

# Client image for the provisioning job: the same image the postgres stack runs
# as a server. A matching tag means the host holds one copy of it rather than
# two, so keep the two stacks in step when bumping.
POSTGRES_TAG=18.6

# Must match POSTGRES_SOCKET_DIR in the postgres stack's .env -- nothing checks
# this, and a mismatch means a job that cannot find the socket. The job mounts
# it read-only and connects over it, which is why no admin password appears
# anywhere in this stack.
POSTGRES_SOCKET_DIR=/run/postgresql

# Must match POSTGRES_ADMIN_USER in the postgres stack's .env. Needed even
# though socket connections need no password: `trust` still authenticates as
# some role, and there is no `postgres` role in this cluster -- initdb named the
# superuser after that variable.
POSTGRES_ADMIN_USER=pgadmin

# The role and database the provisioning job reconciles on every `up`. Not
# secrets; the password is WATERDB_DB_PASSWORD in secrets.enc.env.
WATERDB_DB_NAME=waterdb
WATERDB_DB_USER=waterdb

# --- seeding job (see docker-compose.yml) ------------------------------------

# Host directory holding the data the seeding job loads, bind-mounted at /data.
#
# On /data, a persistent volume, rather than a Docker named volume: it has to
# survive a rebuild of the machine's root filesystem, same reasoning as the
# postgres cluster and the age key in /data/secrets.
#
# Operator-staged input, not something a container creates. The files have to be
# here before `stacks up waterdb`, or the seeding job fails and the application
# is never started behind it.
WATERDB_DATA_DIR=/data/waterdb
