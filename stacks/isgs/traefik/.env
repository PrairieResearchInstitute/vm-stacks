# Non-secret configuration for the traefik stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.

TRAEFIK_TAG=v3.7.11

# Contact address Let's Encrypt uses for expiry warnings.
TRAEFIK_ACME_EMAIL=bengal1@illinois.edu

# Hostname serving the Traefik dashboard (behind basic auth).
TRAEFIK_DASHBOARD_HOST=traefik.isgs.prairie.illinois.edu

# Let's Encrypt endpoint. Staging issues untrusted certs but has generous rate
# limits -- use it while a hostname's DNS is still settling, then switch.
#   staging: https://acme-staging-v02.api.letsencrypt.org/directory
#   prod:    https://acme-v02.api.letsencrypt.org/directory
TRAEFIK_ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Traefik log level: DEBUG INFO WARN ERROR
TRAEFIK_LOG_LEVEL=INFO
