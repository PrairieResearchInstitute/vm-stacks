# Non-secret configuration for the dagster stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.
#
# The authority for every variable below is docs/deploy.md in the dagster-pri
# repo -- it lists the complete set the image reads, which is not guessable from
# the compose file alone.

# The image tag is the GitHub release tag verbatim. Pre-releases produce no
# `latest` and no X.Y alias, so this is always a full four-component tag; see
# the regex in stack.conf.
DAGSTER_TAG=0.1.0-alpha.3

# Hostname Traefik serves the Dagster UI on. DNS for it has to resolve to the
# odsc VM before Let's Encrypt can issue a certificate -- until it does, point
# traefik's TRAEFIK_ACME_CASERVER at staging rather than burning prod rate limit.
#
# There is no host port for this UI, deliberately: Dagster OSS ships no
# authentication of its own, so the only way in is through the proxy and the
# basic-auth middleware in docker-compose.yml. See README.md.
DAGSTER_HOST=dagster.odsc.prairie.illinois.edu

# --- provisioning job (see docker-compose.yml, provision-db.sh) --------------

# Client image for the provisioning job: the same image the postgres stack runs
# as a server. A matching tag means the host holds one copy of it rather than
# two, so keep this stack and ../postgres in step when bumping.
POSTGRES_TAG=18.6

# Must match POSTGRES_SOCKET_DIR in the postgres stack's .env -- nothing checks
# this, and a mismatch means a job that cannot find the socket. The job mounts
# it read-only and connects over it, which is why no admin password appears
# anywhere in this stack.
POSTGRES_SOCKET_DIR=/run/postgresql

# Must match POSTGRES_ADMIN_USER in the postgres stack's .env. Needed even
# though socket connections need no password: `trust` still authenticates as
# some role, and there is no `postgres` role in this cluster -- initdb named the
# superuser after that variable.
POSTGRES_ADMIN_USER=pgadmin

# The role and database the provisioning job reconciles on every `up`, and the
# ones Dagster then connects to as DAGSTER_PG_DB / DAGSTER_PG_USERNAME. This is
# Dagster's own INSTANCE STORAGE -- run, event log, schedule and dynamic
# partition tables. There is no other database in this stack. Not secrets; the
# password is DAGSTER_DB_PASSWORD in secrets.enc.env.
#
# It has to be a real database on a real server rather than the SQLite default:
# the webserver and the daemon are separate processes and must share these
# tables.
DAGSTER_DB_NAME=dagster
DAGSTER_DB_USER=dagster

# --- run concurrency ---------------------------------------------------------

# QueuedRunCoordinator's cap, read by the image's baked dagster.yaml. Runs
# execute as subprocesses of the single dagster container, so this is what keeps
# a backfill from taking the VM's memory with it: one ERA5 month is staged and
# processed in full. Raise it only after watching what one run actually costs.
DAGSTER_MAX_CONCURRENT_RUNS=2

# --- object store ------------------------------------------------------------

# The bucket holding the Icechunk stores, the parquet outputs, the HUC8 clip
# masks and the stations CSV. Its internal layout is fixed by the image and is
# not configurable; see README.md for the prefixes and for the two objects that
# have to exist before the first run.
BUCKET_NAME=public
PRIVATE_BUCKET_NAME=private

# Taiga's S3 gateway at NCSA -- off-host, on a non-standard port, so the
# container needs outbound HTTPS to it. The scheme selects TLS.
#
# The access key and secret are AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in
# secrets.enc.env. All three are the standard AWS SDK names, deliberately: the
# image reads exactly those, and the same environment then works for `aws` or
# boto3 in a debugging shell.
AWS_ENDPOINT_URL=https://taiga-dtn-s3.ncsa.illinois.edu:51016

# --- Copernicus Climate Data Store -------------------------------------------

# Where era5_init and era5_iceberg fetch the raw ERA5-Land data from. The key is
# CDSAPI_KEY in secrets.enc.env; no ~/.cdsapirc file is involved.
CDSAPI_URL=https://cds.climate.copernicus.eu/api

# --- the monthly backfill sensor ---------------------------------------------

# era5_monthly_sensor walks one month at a time from ERA5_START_YM, skipping
# what has already landed in the bucket. UNSET, IT SKIPS EVERY TICK and nothing
# is ever ingested -- which looks like a working deployment doing nothing.
#
# The sensor also ships STOPPED and has to be started once in the UI; see
# README.md.
ERA5_START_YM=2024-01

# Last month to process, inclusive, YYYY-MM. Empty means unbounded: the sensor
# keeps advancing as new ERA5-Land months are published. Set it to pin a
# backfill to a fixed range.
ERA5_END_YM=

# USPS state code. One state per deployment; the clip mask in the bucket has to
# match it.
ERA5_STATE=IL

# --- host directories --------------------------------------------------------

# Bind mounts on /data rather than Docker named volumes, so they survive a
# rebuild of the machine's root filesystem.
#
# BOTH MUST EXIST AND BE OWNED BY UID 1000 before the first `up` -- the image
# runs as uid 1000 and Docker creates a missing bind-mount source as root:
#
#   install -d -o 1000 -g 1000 /data/dagster/local /data/dagster/scratch
#
# DAGSTER_LOCAL_DIR holds compute logs -- op stdout/stderr, which is what the UI
# reads back for a finished run -- and io_manager intermediates. It has to
# persist. DAGSTER_SCRATCH_DIR is TMPDIR inside the image, where a whole month
# of NetCDF is staged; it needs room but not persistence.
DAGSTER_LOCAL_DIR=/data/dagster/local
DAGSTER_SCRATCH_DIR=/data/dagster/scratch
