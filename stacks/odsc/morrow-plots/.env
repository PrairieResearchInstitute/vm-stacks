# Non-secret configuration for the morrow-plots stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.

OWUI_TAG=v0.11.4

# Hostname Traefik serves this application on. DNS for it has to resolve to
# odsc before Let's Encrypt can issue a certificate -- until it does, point
# the traefik stack's TRAEFIK_ACME_CASERVER at staging rather than burning
# prod rate limit.
MORROWPLOTS_HOST=morrow-plots.odsc.prairie.illinois.edu

# --- persistent storage, both under /data/owui-datasherpa --------------------
#
# /data/owui-datasherpa is the umbrella for every OWUI app instance's own
# storage on this VM -- split by what survives loss, not by instance:
#   data/<instance>   OWUI's own app data: chats, uploads, RAG index, users.
#                     Irreplaceable if lost -- back this branch up.
#   repos/<instance>  The project's own codebase, cloned read-only for
#                     code-gen Tools. Disposable -- a `git clone` away if
#                     lost, deliberately excludable from backups.
# Both named "morrow-plots", matching this stack's own name, container name,
# and hostname -- one instance, one name, used consistently everywhere,
# rather than a second short-form alias that only exists in these two paths.
#
# owui-postgres itself is NOT under here: it is shared infrastructure
# serving every instance, parallel to the unrelated `postgres` stack, so it
# gets its own flat /data/owui-postgres instead -- see that stack's README.

# This instance's own OWUI data: uploaded files, RAG index state, chat
# history. On /data -- a persistent volume -- rather than a Docker named
# volume, so it survives a rebuild of the machine's root filesystem, same
# reasoning as the postgres cluster itself.
MORROWPLOTS_DATA_DIR=/data/owui-datasherpa/data/morrow-plots

# This project's own codebase, read-only, for if/when code-generation Tools
# need it (see docker-compose.yml's commented mount). Clone it here by hand
# before uncommenting that line -- this stack does not clone it for you.
MORROWPLOTS_REPO_DIR=/data/owui-datasherpa/repos/morrow-plots

# --- provisioning job (see docker-compose.yml, provision-db.sh) --------------

# Client image for the provisioning job: the SAME image the owui-postgres
# stack runs as a server. A matching tag means the host holds one copy of it
# rather than two; keep this in step with stacks/odsc/owui-postgres/.env when
# bumping either one.
POSTGRES_TAG=0.8.6-pg18

# Must match POSTGRES_SOCKET_DIR / POSTGRES_ADMIN_USER in the owui-postgres
# stack's .env, NOT the unrelated `postgres` stack's -- nothing checks this,
# and a mismatch means a job that cannot find the socket, or authenticates as
# a role that does not exist on this cluster.
POSTGRES_SOCKET_DIR=/run/owui-postgresql
POSTGRES_ADMIN_USER=owui_pgadmin

# The role and database the provisioning job reconciles on every `up`, and the
# database pgvector is enabled in. Not secrets; the password is
# MORROWPLOTS_DB_PASSWORD in secrets.enc.env.
MORROWPLOTS_DB_NAME=morrowplots
MORROWPLOTS_DB_USER=morrowplots
