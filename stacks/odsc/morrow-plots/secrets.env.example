# Template for this stack's secrets. This .example file is plaintext and
# committed; the real values live in secrets.enc.env, encrypted.
#
# Create it with:
#   stacks --vm odsc edit-secrets morrow-plots
#
# Opens $EDITOR with these two keys — fill in real generated values
# (openssl rand -base64 32 for the password, openssl rand -hex 32 for the
# secret key), save and quit. Delete this .example file once that real one
# exists — see docs/adding-a-stack.md.

MORROWPLOTS_DB_PASSWORD=replace-me
MORROWPLOTS_WEBUI_SECRET_KEY=replace-me
