# Non-secret configuration for the owui-postgres stack. Committed on purpose.
# Tags are managed by `stacks bump`; the rest is edited by hand.

# pgvector/pgvector's tag scheme: <pgvector-version>-pg<postgres-major>.
# 0.8.6-pg18 is postgres:18.6 plus the pgvector extension -- see stack.conf
# and README.md.
POSTGRES_TAG=0.8.6-pg18

# Superuser created by initdb on first boot. Its password is
# OWUI_POSTGRES_ADMIN_PASSWORD in secrets.enc.env.
#
# Changing this after the first boot does NOT rename the role -- initdb only
# runs against an empty data directory. Rename it in SQL instead.
POSTGRES_ADMIN_USER=owui_pgadmin

# Host directory holding this cluster, bind-mounted at /var/lib/postgresql.
#
# Flat at the top of /data, like the other cluster's own /data/postgres --
# this is shared infrastructure, not one OWUI instance's data, so it does NOT
# live under /data/owui-datasherpa (see that tree's own layout note in
# morrow-plots/.env).
#
# Deliberately NOT /data/postgres -- that path belongs to the OTHER,
# already-running postgres cluster (dagster's). Mounting a second, different
# image's container there would either fail to start against an
# incompatible existing data directory or, worse, corrupt it.
#
# The image's PGDATA is /var/lib/postgresql/18/docker, so the files actually
# land in ${POSTGRES_DATA_DIR}/18/docker.
POSTGRES_DATA_DIR=/data/owui-postgres

# Passed to initdb on first boot only. --data-checksums makes Postgres detect
# silent corruption on read; it cannot be turned on later without rewriting
# the cluster, so it goes on from the start.
POSTGRES_INITDB_ARGS=--data-checksums

# Host directory this server's Unix socket is published into, bind-mounted at
# /var/run/postgresql.
#
# Deliberately NOT /run/postgresql -- that path is where the OTHER postgres
# cluster already publishes its socket. Two different Unix sockets cannot
# share one path: whichever server started second would either fail to bind
# or clobber the first one's socket file. This cluster gets its own path.
#
# On /run, still not /data: a socket is runtime state, not data, same
# reasoning as the other cluster's README.
#
# Mounting this directory into a container grants postgres SUPERUSER, via the
# `local all all trust` line in pg_hba.conf. Keep the list of stacks that do
# it short and deliberate; see README.md.
POSTGRES_SOCKET_DIR=/run/owui-postgresql
