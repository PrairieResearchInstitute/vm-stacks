# Template for this stack's secrets. This .example file is plaintext and
# committed; the real values live in secrets.enc.env, encrypted.
#
# To create the encrypted file:
#   stacks edit-secrets <stackname>
#
# ...or from an existing plaintext file:
#   sops --encrypt --filename-override secrets.enc.env \
#        --input-type dotenv --output-type dotenv secrets.env > secrets.enc.env
#   rm secrets.env
#
# Values land in the container environment, which means they are visible in
# `docker inspect`. For anything higher-value than a hash or an API token
# scoped to this host, use a compose `secrets:` file mount instead.

EXAMPLE_API_TOKEN=replace-me
